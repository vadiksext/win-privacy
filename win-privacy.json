  "groups": [
    {
      "id": "Telemetry",
      "title": "Диагностические данные и отчёты об ошибках",
      "items": [
        { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowTelemetry", "value": 1, "accept": [0], "note": "только обязательные диагностические данные" },
        { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "LimitDiagnosticLogCollection", "value": 1, "note": "не отправлять дополнительные журналы диагностики" },
        { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "LimitDumpCollection", "value": 1, "note": "не отправлять полные дампы памяти" },
        { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "AllowDeviceNameInTelemetry", "value": 0, "note": "не отправлять имя компьютера" },
        { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\DataCollection", "name": "DoNotShowFeedbackNotifications", "value": 1, "note": "не показывать запросы отзывов" },
        { "hive": "HKCU", "path": "Software\\Policies\\Microsoft\\Windows\\CloudContent", "name": "DisableTailoredExperiencesWithDiagnosticData", "value": 1, "note": "не использовать диагностические данные для «персонализированных возможностей»" },
        { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\AdvertisingInfo", "name": "DisabledByGroupPolicy", "value": 1, "note": "отключить рекламный идентификатор" },
        { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\AppCompat", "name": "AITEnable", "value": 0, "note": "отключить телеметрию приложений" },
        { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\AppCompat", "name": "DisableInventory", "value": 1, "note": "не собирать опись установленных программ" },
        { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\SQMClient\\Windows", "name": "CEIPEnable", "value": 0, "note": "отключить программу улучшения качества" },
        { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\Windows\\Windows Error Reporting", "name": "Disabled", "value": 1, "note": "не отправлять отчёты об ошибках (в них попадает память программ с открытыми документами)" }
      ]
    },
    {
