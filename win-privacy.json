      "items": [
        { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\InputPersonalization", "name": "AllowInputPersonalization", "value": 0, "note": "отключить распознавание речи через интернет" },
        { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\InputPersonalization", "name": "RestrictImplicitInkCollection", "value": 1, "note": "не собирать образцы рукописного ввода" },
        { "hive": "HKLM", "path": "SOFTWARE\\Policies\\Microsoft\\InputPersonalization", "name": "RestrictImplicitTextCollection", "value": 1, "note": "не собирать набранный текст" },
